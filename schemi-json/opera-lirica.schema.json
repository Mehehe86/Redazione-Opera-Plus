{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opera+ — Scheda opera lirica v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versione",
    "id",
    "tipo",
    "titolo",
    "compositori",
    "librettisti",
    "prima_rappresentazione",
    "personaggi",
    "versioni",
    "edizioni_riferimento",
    "fonti",
    "gestione"
  ],
  "properties": {
    "versione": {
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "const": "opera"
    },
    "titolo": {
      "type": "string",
      "minLength": 1
    },
    "titoli_alternativi": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compositori": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "librettisti": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "genere": {
      "type": [
        "string",
        "null"
      ]
    },
    "struttura": {
      "type": [
        "string",
        "null"
      ]
    },
    "lingue_libretto": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fonti_letterarie": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fatto"
      }
    },
    "prima_rappresentazione": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "teatro",
        "citta",
        "paese",
        "fonti_ids"
      ],
      "properties": {
        "data": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "teatro": {
          "type": [
            "string",
            "null"
          ]
        },
        "citta": {
          "type": [
            "string",
            "null"
          ]
        },
        "paese": {
          "type": [
            "string",
            "null"
          ]
        },
        "fonti_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "teatro": {
                "type": "string"
              }
            },
            "required": [
              "teatro"
            ]
          },
          "then": {
            "properties": {
              "citta": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ambientazione": {
      "type": [
        "string",
        "null"
      ]
    },
    "sinossi": {
      "type": [
        "string",
        "null"
      ]
    },
    "personaggi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "registro_vocale",
          "fonti_ids"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "registro_vocale": {
            "type": [
              "string",
              "null"
            ]
          },
          "descrizione": {
            "type": [
              "string",
              "null"
            ]
          },
          "versioni_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fonti_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "versioni": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "denominazione",
          "descrizione",
          "fonti_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "denominazione": {
            "type": "string",
            "minLength": 1
          },
          "anno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "descrizione": {
            "type": "string",
            "minLength": 1
          },
          "modifiche_documentate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fonti_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Solo versioni storiche effettivamente documentate; non includere edizioni critiche o libretti moderni."
    },
    "contesto_storico": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fatto"
      }
    },
    "note_musicali_drammaturgiche": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testo",
          "natura",
          "fonti_ids"
        ],
        "properties": {
          "testo": {
            "type": "string",
            "minLength": 1
          },
          "natura": {
            "enum": [
              "documentazione",
              "interpretazione_attribuita"
            ]
          },
          "attribuzione": {
            "type": [
              "string",
              "null"
            ]
          },
          "fonti_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risorse": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "titolo",
          "url",
          "fonti_ids"
        ],
        "properties": {
          "tipo": {
            "enum": [
              "libretto",
              "partitura",
              "edizione_critica",
              "studio",
              "archivio",
              "altro"
            ]
          },
          "titolo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accesso": {
            "type": [
              "string",
              "null"
            ]
          },
          "fonti_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fonti": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fonte"
      }
    },
    "gestione": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stato",
        "aggiornato_il"
      ],
      "properties": {
        "stato": {
          "enum": [
            "bozza",
            "approvata",
            "da_verificare"
          ]
        },
        "aggiornato_il": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "edizioni_riferimento": {
      "type": "array",
      "description": "Testi e edizioni del libretto o della partitura, distinte dalle versioni storiche dell'opera. Riportare curatore, natura e fonti quando noti.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titolo",
          "tipo",
          "curatore",
          "descrizione",
          "fonti_ids"
        ],
        "properties": {
          "titolo": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "edizione_critica",
              "libretto",
              "partitura",
              "altra_edizione"
            ]
          },
          "curatore": {
            "type": [
              "string",
              "null"
            ]
          },
          "descrizione": {
            "type": [
              "string",
              "null"
            ]
          },
          "anno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "risorsa_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "fonti_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "fonti_ids"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "fonti_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fatto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testo",
        "fonti_ids"
      ],
      "properties": {
        "testo": {
          "type": "string",
          "minLength": 1
        },
        "fonti_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titolo",
        "url",
        "consultata_il",
        "attesta"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titolo": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "consultata_il": {
          "type": "string",
          "format": "date"
        },
        "attesta": {
          "type": "string",
          "minLength": 1
        },
        "nota": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
